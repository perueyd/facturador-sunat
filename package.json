{
  "name": "facturador-sunat",
  "version": "0.11.0",
  "private": true,
  "description": "Facturador electrónico propio para SUNAT (SEE - Del Contribuyente)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrar": "tsx --env-file-if-exists=.env scripts/migrar.ts",
    "db:prueba": "bash scripts/db-prueba.sh",
    "ejemplos": "tsx --env-file-if-exists=.env scripts/generar-ejemplos.ts",
    "llave:generar": "tsx scripts/generar-llave.ts",
    "certificado:cargar": "tsx --env-file-if-exists=.env scripts/cargar-certificado.ts",
    "certificado:exportar-cer": "tsx --env-file-if-exists=.env scripts/exportar-cer.ts",
    "sunat:beta": "tsx --env-file-if-exists=.env scripts/prueba-beta.ts",
    "cola:procesar": "tsx --env-file-if-exists=.env scripts/procesar-cola.ts",
    "servidor": "tsx --env-file-if-exists=.env src/servidor.ts",
    "empresa:configurar": "tsx --env-file-if-exists=.env scripts/empresa.ts",
    "empresa:modulos": "tsx --env-file-if-exists=.env scripts/modulos.ts",
    "llave-api": "tsx --env-file-if-exists=.env scripts/llave-api.ts",
    "usuario": "tsx --env-file-if-exists=.env scripts/usuario.ts",
    "sol:configurar": "tsx --env-file-if-exists=.env scripts/credenciales-sol.ts",
    "inventario": "tsx --env-file-if-exists=.env scripts/inventario.ts",
    "reporte": "tsx --env-file-if-exists=.env scripts/reporte.ts",
    "devolucion": "tsx --env-file-if-exists=.env scripts/devolucion.ts",
    "analizar": "tsc --noEmit && knip"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@xmldom/xmldom": "^0.9.12",
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "xml-crypto": "^6.4.0",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "knip": "^6.42.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
